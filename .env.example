# AWS Bedrock Configuration (primary LLM)
# Uses your default AWS credentials (aws configure / IAM role / env vars)
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Set to "true" to enable Bedrock LLM (requires AWS credentials)
# Default is "false" -- app works fully without LLM using local models
USE_LLM=false

# Data paths (defaults work if data/ folder is in project root)
POSTS_PATH=data/posts.jsonl
AUTHORS_PATH=data/authors.csv
ENTITIES_PATH=data/entities_seed.csv
